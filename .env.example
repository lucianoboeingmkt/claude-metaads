# Facebook/Meta access token with ads_read and ads_management permissions
# For production, use a System User token from Business Manager (does not expire)
# For testing, use the Graph API Explorer: https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=your_access_token_here

# Optional bearer token required on /mcp in HTTP mode
MCP_API_KEY=your_api_key_here

# Optional HTTP port for --http mode
PORT=3005
